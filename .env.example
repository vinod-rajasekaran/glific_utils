# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# Variables already set in your shell take precedence over this file.

# Glific API host (no trailing /api)
GLIFIC_URL=https://api.yourorg.glific.com

# Staff login: phone number with country code, and password
GLIFIC_PHONE=91XXXXXXXXXX
GLIFIC_PASSWORD=change-me

# Optional: time zone for local times on the HTML page (default Asia/Kolkata)
GLIFIC_TZ=Asia/Kolkata

# Optional: Claude's reading of the flows as programmes. Needs `pip install anthropic` (see README).
# Without a key the page groups flows by their links instead; --no-claude does the same on purpose.
# ANTHROPIC_API_KEY=sk-ant-...   (or sign in with `ant auth login`)

# Optional: let the MCP server (glific_mcp) create flows and collections and start flows, which messages real people.
# Off unless set to 1.
# GLIFIC_MCP_ALLOW_WRITES=1
